{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": false,
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "allowJs": true,
        "baseUrl": "./src",
        "paths": {
            "@/*": ["./*"],
            "App/*": ["external/trader/src/App/*"],
            "AppV2/*": ["external/trader/src/AppV2/*"],
            "Modules/*": ["external/trader/src/Modules/*"],
            "Stores/*": ["external/trader/src/Stores/*"],
            "Sass/*": ["external/trader/src/sass/*"],
            "Assets/*": ["external/trader/src/Assets/*"],
            "Types": ["external/trader/src/Types"],
            "_common/*": ["external/trader/src/_common/*"]
        },
        "esModuleInterop": true,
        "types": ["jest", "@testing-library/jest-dom"]
    },
    "include": ["src"]
}
